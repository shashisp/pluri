{
  "name": "pluri",
  "version": "0.1.0",
  "description": "Multi-Repo Agent Orchestrator — spawns parallel headless Claude Code agents across independent git repos grouped by ticket.",
  "main": "./out/main/index.js",
  "author": "shashikumarp",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:parser": "node --experimental-strip-types scripts/test-parser.ts",
    "test:e2e": "esbuild scripts/e2e-agent.ts --bundle --platform=node --format=esm --external:electron --alias:@shared=./src/shared --outfile=out/e2e-agent.mjs && node out/e2e-agent.mjs",
    "test:db": "esbuild scripts/test-db.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --alias:@shared=./src/shared --outfile=out/test-db.cjs && ELECTRON_RUN_AS_NODE=1 electron out/test-db.cjs",
    "test:fanout": "esbuild scripts/test-fanout.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:simple-git --alias:@shared=./src/shared --outfile=out/test-fanout.mjs && ELECTRON_RUN_AS_NODE=1 electron out/test-fanout.mjs",
    "test:git": "esbuild scripts/test-git.ts --bundle --platform=node --format=esm --external:simple-git --alias:@shared=./src/shared --outfile=out/test-git.mjs && node out/test-git.mjs",
    "test:contract": "esbuild scripts/test-contract.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:simple-git --alias:@shared=./src/shared --outfile=out/test-contract.mjs && ELECTRON_RUN_AS_NODE=1 electron out/test-contract.mjs",
    "test:memory": "esbuild scripts/test-memory.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:simple-git --alias:@shared=./src/shared --outfile=out/test-memory.mjs && ELECTRON_RUN_AS_NODE=1 electron out/test-memory.mjs",
    "test:concurrency": "esbuild scripts/test-concurrency.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --outfile=out/test-concurrency.mjs && node out/test-concurrency.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.21.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^42.5.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.0"
  }
}
