{
  "name": "pluri",
  "version": "0.1.0",
  "description": "Multi-Repo Agent Orchestrator — spawns parallel headless Claude Code agents across independent git repos grouped by ticket.",
  "main": "./out/main/index.js",
  "author": "shashikumarp",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:parser": "node --experimental-strip-types scripts/test-parser.ts",
    "test:e2e": "esbuild scripts/e2e-agent.ts --bundle --platform=node --format=esm --external:electron --alias:@shared=./src/shared --outfile=out/e2e-agent.mjs && node out/e2e-agent.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
